exports[`props validation > can validate through slots 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { createComponent, markRaw } = helpers;
  const comp1 = createComponent(\`Child\`, true, false, false, []);
  const comp2 = createComponent(\`Wrapper\`, true, true, false, []);
  
  function slot1(ctx, node, key = "") {
    return comp1({}, key + \`__1\`, node, this, null);
  }
  
  return function template(ctx, node, key = "") {
    return comp2({slots: markRaw({'default': {__render: slot1.bind(this), __ctx: ctx}})}, key + \`__2\`, node, this, null);
  }
}"
`;

exports[`props validation > default values are applied before validating props at update 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { createComponent } = helpers;
  const comp1 = createComponent(\`SubComp\`, true, false, false, ["p"]);
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node, key = "") {
    const b2 = comp1({p: ctx['this'].state.p}, key + \`__1\`, node, this, null);
    return block1([], [b2]);
  }
}"
`;

