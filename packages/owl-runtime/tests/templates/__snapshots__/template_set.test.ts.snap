exports[`template set without components > renders a template whose components are not rendered 1`] = `
"function anonymous(templates, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { createComponent } = helpers;
  // Template name: "main"
  const comp1 = createComponent(\`Child\`, true, false, false, []);
  
  let block1 = createBlock(\`<div><block-child-0/>ok</div>\`);
  
  return function template_main(ctx, node, key = "") {
    let b2;
    if (false) {
      b2 = comp1({}, key + \`__1\`, node, this, null);
    }
    return block1([], [b2]);
  }
}"
`;

