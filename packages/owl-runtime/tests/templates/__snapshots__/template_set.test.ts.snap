exports[`loading templates > can load a few templates from a xml string 1`] = `
"function anonymous(templates, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { callTemplate } = helpers;
  // Template name: "main"
  
  let block1 = createBlock(\`<ul><block-child-0/></ul>\`);
  
  return function template_main(ctx, node, key = "") {
    const b2 = callTemplate(\`items\`, this, templates, ctx, node, key + \`__1\`);
    return block1([], [b2]);
  }
}"
`;

exports[`loading templates > can load a few templates from a xml string 2`] = `
"function anonymous(templates, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  // Template name: "items"
  
  let block2 = createBlock(\`<li>ok</li>\`);
  let block3 = createBlock(\`<li>foo</li>\`);
  
  return function template_items(ctx, node, key = "") {
    const b2 = block2();
    const b3 = block3();
    return multi([b2, b3]);
  }
}"
`;

