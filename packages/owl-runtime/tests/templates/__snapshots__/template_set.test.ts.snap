// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`loading templates > addTemplates does not modify its xml document in place 1`] = `
"function anonymous(templates, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { safeOutput } = helpers;
  // Template name: "hey"
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template_hey(ctx, node, key = "") {
    const b2 = safeOutput(ctx['value']);
    return block1([], [b2]);
  }
}"
`;

