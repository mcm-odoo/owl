exports[`template set without components > throws a clear error when rendering a signal prop 1`] = `
"function anonymous(templates, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { toSignal, createComponent } = helpers;
  // Template name: "main"
  const comp1 = createComponent(\`Child\`, true, false, false, []);
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template_main(ctx, node, key = "") {
    const b2 = comp1({value: toSignal(node, \`__sig_1\`, 1)}, key + \`__1\`, node, this, null);
    return block1([], [b2]);
  }
}"
`;

