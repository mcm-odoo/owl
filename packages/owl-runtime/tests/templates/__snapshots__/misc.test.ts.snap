// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`misc > complex template 1`] = `
"function anonymous(templates, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { safeOutput, prepareList, createComponent, withKey } = helpers;
  const comp1 = createComponent(\`SlotButton\`, true, false, false, ["class","slot"]);
  
  let block1 = createBlock(\`<div block-attribute-0="class"><div block-attribute-1="class"><div class="batch_header"><a block-attribute-2="href" block-attribute-3="class" title="View Batch"><block-child-0/><block-child-1/><i class="arrow fa fa-window-maximize"/></a></div><block-child-2/><div class="batch_slots"><block-child-3/><block-child-4/></div><div class="batch_commits"><block-child-5/></div></div></div>\`);
  let block3 = createBlock(\`<i class="fa fa-exclamation-triangle"/>\`);
  let block4 = createBlock(\`<span><i class="fa fa-cog fa-spin fa-fw"/> preparing</span>\`);
  let block8 = createBlock(\`<div class="slot_filler"/>\`);
  let block10 = createBlock(\`<div class="one_line"><a block-attribute-0="href" block-attribute-1="class"><block-child-0/><block-child-1/><block-child-2/><block-child-3/><block-child-4/></a><a block-attribute-2="href" class="badge badge-light" title="View Commit on Github"><i class="fa fa-github"/></a><span><block-child-5/></span></div>\`);
  let block11 = createBlock(\`<i class="fa fa-fw fa-hashtag" title="This commit is a new head"/>\`);
  let block12 = createBlock(\`<i class="fa fa-fw fa-link" title="This commit is an existing head from bundle branches"/>\`);
  let block13 = createBlock(\`<i class="fa fa-fw fa-code-fork" title="This commit is matched from a base batch with matching merge_base"/>\`);
  let block14 = createBlock(\`<i class="fa fa-fw fa-clock-o" title="This commit is the head of a base branch"/>\`);
  
  return function template(ctx, node, key = "") {
    let b2, b3, b4, b5, b7, b9;
    let attr1 = \`batch_tile \${ctx['options'].more?'more':'nomore'}\`;
    let attr2 = \`card bg-\${ctx['klass']}-light\`;
    let attr3 = \`/runbot/batch/\${ctx['batch'].id}\`;
    let attr4 = \`badge badge-\${ctx['batch'].has_warning?'warning':'light'}\`;
    b2 = safeOutput(ctx['batch'].formated_age);
    if (ctx['batch'].has_warning) {
      b3 = block3();
    }
    if (ctx['batch'].state=='preparing') {
      b4 = block4();
    }
    const ctx1 = ctx;
    const [k_block5, v_block5, l_block5, c_block5] = prepareList(ctx['batch'].slot_ids.filter(_slot=>_slot.build_id.id&&!_slot.trigger_id.manual&&(ctx['options'].trigger_display[_slot.trigger_id.id])));;
    for (let i1 = 0; i1 < l_block5; i1++) {
      let ctx = Object.create(ctx1);
      ctx[\`slot\`] = k_block5[i1];
      const key1 = ctx['slot'].id;
      c_block5[i1] = withKey(comp1({class: ctx['slot_container'],slot: ctx['slot']}, key + \`__1__\${key1}\`, node, this, null), key1);
    }
    b5 = list(c_block5);
    const ctx2 = ctx;
    const [k_block7, v_block7, l_block7, c_block7] = prepareList([1,2,3,4]);;
    for (let i1 = 0; i1 < l_block7; i1++) {
      let ctx = Object.create(ctx2);
      ctx[\`x\`] = k_block7[i1];
      const key1 = ctx['x'];
      c_block7[i1] = withKey(block8(), key1);
    }
    b7 = list(c_block7);
    const ctx3 = ctx;
    const [k_block9, v_block9, l_block9, c_block9] = prepareList(ctx['commit_links']);;
    for (let i1 = 0; i1 < l_block9; i1++) {
      let ctx = Object.create(ctx3);
      ctx[\`commit_link\`] = k_block9[i1];
      const key1 = ctx['commit_link'].id;
      let b11, b12, b13, b14, b15, b16;
      let attr5 = \`/runbot/commit/\${ctx['commit_link'].commit_id}\`;
      let attr6 = \`badge badge-light batch_commit match_type_\${ctx['commit_link'].match_type}\`;
      if (ctx['commit_link'].match_type=='new') {
        b11 = block11();
      }
      if (ctx['commit_link'].match_type=='head') {
        b12 = block12();
      }
      if (ctx['commit_link'].match_type=='base_match') {
        b13 = block13();
      }
      if (ctx['commit_link'].match_type=='base_head') {
        b14 = block14();
      }
      b15 = safeOutput(ctx['commit_link'].commit_dname);
      let attr7 = 'https://%s/commit/%s'%(ctx['commit_link'].commit_remote_url,ctx['commit_link'].commit_name);
      b16 = safeOutput(ctx['commit_link'].commit_subject);
      c_block9[i1] = withKey(block10([attr5, attr6, attr7], [b11, b12, b13, b14, b15, b16]), key1);
    }
    b9 = list(c_block9);
    return block1([attr1, attr2, attr3, attr4], [b2, b3, b4, b5, b7, b9]);
  }
}"
`;

exports[`misc > global 1`] = `
"function anonymous(templates, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { prepareList, safeOutput, callTemplate, zero, withKey } = helpers;
  // Template name: "caller"
  
  let block1 = createBlock(\`<div><block-child-0/><block-child-1/></div>\`);
  let block4 = createBlock(\`<span><block-child-0/></span>\`);
  
  function callBody1(ctx, node, key = "") {
    ctx = Object.create(ctx);
    const b8 = callTemplate(\`_callee-uses-foo\`, this, templates, Object.assign(Object.create(ctx), {foo: 'aaa'}), node, key + \`__1\`);
    const b9 = callTemplate(\`_callee-uses-foo\`, this, templates, ctx, node, key + \`__2\`);
    ctx["foo"] = 'bbb';
    const b10 = callTemplate(\`_callee-uses-foo\`, this, templates, ctx, node, key + \`__3\`);
    return multi([b8, b9, b10]);
  }
  
  return function template_caller(ctx, node, key = "") {
    const ctx1 = ctx;
    const [k_block2, v_block2, l_block2, c_block2] = prepareList([4,5,6]);;
    for (let i1 = 0; i1 < l_block2; i1++) {
      let ctx = Object.create(ctx1);
      ctx[\`value\`] = k_block2[i1];
      ctx[\`value_first\`] = i1 === 0;
      ctx[\`value_last\`] = i1 === k_block2.length - 1;
      ctx[\`value_index\`] = i1;
      ctx[\`value_value\`] = v_block2[i1];
      const key1 = ctx['value'];
      const b5 = safeOutput(ctx['value']);
      const b4 = block4([], [b5]);
      const lazyBlock1 = callBody1.bind(this, ctx);
      const b6 = callTemplate(\`_callee-asc\`, this, templates, Object.assign(Object.create(ctx), {[zero]: lazyBlock1}), node, key + \`__4__\${key1}\`);
      c_block2[i1] = withKey(multi([b4, b6]), key1);
    }
    const b2 = list(c_block2);
    const b11 = callTemplate(\`_callee-asc-toto\`, this, templates, ctx, node, key + \`__5\`);
    return block1([], [b2, b11]);
  }
}"
`;

exports[`misc > global 2`] = `
"function anonymous(templates, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { zero } = helpers;
  // Template name: "_callee-asc"
  
  let block1 = createBlock(\`<año block-attribute-0="falló"><block-child-0/></año>\`);
  
  return function template__callee_asc(ctx, node, key = "") {
    let attr1 = 'agüero';
    const b2 = ctx[zero]?.(node, key) || text("");
    return block1([attr1], [b2]);
  }
}"
`;

exports[`misc > global 3`] = `
"function anonymous(templates, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { safeOutput } = helpers;
  // Template name: "_callee-uses-foo"
  
  let block1 = createBlock(\`<span><block-child-0/></span>\`);
  
  return function template__callee_uses_foo(ctx, node, key = "") {
    const b3 = text(\`foo default\`);
    const b2 = safeOutput(ctx['foo'], b3);
    return block1([], [b2]);
  }
}"
`;

exports[`misc > global 4`] = `
"function anonymous(templates, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { safeOutput } = helpers;
  // Template name: "_callee-asc-toto"
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template__callee_asc_toto(ctx, node, key = "") {
    const b3 = text(\`toto default\`);
    const b2 = safeOutput(ctx['toto'], b3);
    return block1([], [b2]);
  }
}"
`;
